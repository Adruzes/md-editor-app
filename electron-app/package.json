{
  "name": "mdnote",
  "productName": "MDNote",
  "version": "1.0.0",
  "description": "MDノート - 軽量Markdownエディタ",
  "main": "main.js",
  "private": true,
  "author": "D4D",
  "scripts": {
    "sync": "node scripts/sync-app.js",
    "start": "npm run sync && electron .",
    "prepackage-win": "node scripts/sync-app.js",
    "package-win": "electron-packager . MDNote --platform=win32 --arch=x64 --electron-version=43.4.1 --out=dist --overwrite --icon=icon.ico --ignore=\"^/(node_modules|dist)($|/)\" --app-copyright=\"MDNote\" --win32metadata.CompanyName=\"MDNote\" --win32metadata.ProductName=\"MDNote\" --win32metadata.FileDescription=\"MDNote - lightweight markdown editor\""
  },
  "devDependencies": {
    "electron-packager": "^17.1.2"
  }
}
